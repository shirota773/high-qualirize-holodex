{
  "manifest_version": 3,
  "name": "Holodex Video Quality Enhancer",
  "version": "1.1.0",
  "description": "Enables high-quality video playback on Holodex by using iframe size manipulation with CSS transform scaling",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://holodex.net/*",
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://holodex.net/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://holodex.net/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
